// The BGG Financial Accelerator Loop
digraph BGG_Financial_Accelerator {
	node [fontname=Helvetica fontsize=12 shape=box style=rounded]
	edge [fontname=Helvetica fontsize=10]
	A [label="Positive Shock (e.g., to technology)"]
	B [label="Higher Firm Profits & Net Worth"]
	C [label="Lower Firm Leverage (K/N)"]
	D [label="Lower External Finance Premium (EFP)"]
	E [label="Increased Investment & Aggregate Demand"]
	A -> B
	B -> C [label="Improves Balance Sheet"]
	C -> D [label="Reduces Agency Costs"]
	D -> E [label="Lowers Cost of Capital"]
	E -> B [label="Amplifies Cycle" style=dashed]
}
